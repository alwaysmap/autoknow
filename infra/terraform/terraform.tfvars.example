# Template for a NEW instance: copy to instances/<name>.tfvars and fill in (the wrapper
# passes -var-file=instances/$INSTANCE.tfvars; the deployed one is instances/alwaysmap.tfvars).
# No secrets here — secret *values* are loaded into Secret Manager out-of-band from the local
# .env (see deploy notes below).
#
# project_id must be globally unique.
project_id      = "autoknow-prod-XXXX"
billing_account = "XXXXXX-XXXXXX-XXXXXX" # gcloud billing accounts list
org_id          = "1043306095275"        # AlwaysMap
region          = "us-central1"
allowed_domain  = "alwaysmap.com"
# image is set by the deploy step once the first image is pushed:
# image = "us-central1-docker.pkg.dev/<project>/autoknow/autoknow:<sha>"

# --- Ingestion drain alarm (issue #38) — off by default ---
# The app runs fine without it (the alarm is pure observability). To activate: set the
# destination address AND flip the switch, then a human `terraform apply` creates the
# log-based metrics + Cloud Monitoring alert policies + email channel.
# enable_ingestion_alarm = true
# ingestion_alarm_email  = "you@alwaysmap.com"

