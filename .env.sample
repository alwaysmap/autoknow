# Copy to .env and fill in. .env is gitignored.

# --- Database (Postgres + pgvector) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autoknow?schema=public"

# --- Auth.js v5 (Google sign-in) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth Web client (Google Cloud → Google Auth Platform → Clients).
#   Authorized JavaScript origin: http://localhost:3000
#   Authorized redirect URI:      http://localhost:3000/api/auth/callback/google
#   (register every port you actually serve on — e.g. :3100 for a prod build —
#    or sign-in fails with redirect_uri_mismatch)
#   Required scope (Data Access): https://www.googleapis.com/auth/drive.readonly
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Restrict sign-in to one Google Workspace domain (e.g. google.com).
# Leave EMPTY to allow any Google account (use empty when testing with a @gmail.com login).
AUTH_ALLOWED_DOMAIN=""

# --- Gemini (doc summarization + 768-dim embeddings) ---
# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- Refresh worker (re-checks watched sources; docs/OPERATIONS.md §4) ---
# Shared secret for GET /api/cron/refresh. The route refuses to run (503) while
# this is empty. The scheduler presents the SAME string, preferably via the
# "Authorization: Bearer <secret>" header (?secret= also works for hex secrets,
# but base64's "+" decodes as a space in query strings).
# Generate: openssl rand -hex 24
CRON_SECRET=""

# --- Drive service account (prepared — activates with background Drive sync) ---
# The identity users share Docs/folders with. Create with NO IAM roles (sharing
# is the grant); paste the JSON key inline OR point to the file. Until Drive
# sync ships this only switches the notice on Manage → Sources.
# See docs/OPERATIONS.md §5 (including the Workspace external-sharing gotcha).
GOOGLE_SERVICE_ACCOUNT_JSON=""
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/key.json"

# --- Optional: admin/dev endpoints ---
# If set, /api/admin/seed requires this token via the x-admin-token header.
# If unset, those destructive ops are allowed only outside production.
ADMIN_TOKEN=""
