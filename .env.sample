# Copy to .env and fill in. .env is gitignored.
#
# A git worktree cannot inherit .env — `npm ci` links it from the main checkout
# (scripts/dev/link-env.sh). This file is the template for a FIRST checkout.
#
# Every variable the app code reads is listed here, and tests/envSample.test.ts
# fails if that stops being true. Sections: what you set locally, what only
# production sets, and the escape hatches you will almost never touch.

# =============================================================================
# LOCAL DEVELOPMENT — set these
# =============================================================================

# --- Database (Postgres + pgvector) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autoknow?schema=public"

# --- Auth.js v5 (Google sign-in) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth Web client (Google Cloud → Google Auth Platform → Clients).
#   Authorized JavaScript origin: http://localhost:3000
#   Authorized redirect URI:      http://localhost:3000/api/auth/callback/google
#   (register every port you actually serve on — e.g. :3100 for a prod build —
#    or sign-in fails with redirect_uri_mismatch)
#   Required scope (Data Access): https://www.googleapis.com/auth/drive.readonly
# Leave BOTH empty for a stub signed-in identity and no Google login — that is
# how `npm run demo` and the e2e suite run.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Restrict sign-in to one Google Workspace domain (e.g. google.com).
# Leave EMPTY to allow any Google account (use empty when testing with a @gmail.com login).
AUTH_ALLOWED_DOMAIN=""

# --- Gemini (doc summarization + 768-dim embeddings) ---
# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- Refresh worker (re-checks watched sources; docs/OPERATIONS.md §4) ---
# Shared secret for GET /api/cron/refresh. The route refuses to run (503) while
# this is empty. The scheduler presents the SAME string, preferably via the
# "Authorization: Bearer <secret>" header (?secret= also works for hex secrets,
# but base64's "+" decodes as a space in query strings).
# Generate: openssl rand -hex 24
CRON_SECRET=""

# Compress the refresh cadence table (lib/refresh): the number of seconds its SLOWEST
# class should take, with every class scaled proportionally. Leave EMPTY everywhere that
# is not a demo — unset means the real cadence (6h for trackers, a week for the rest).
# `npm run demo` sets it so a week of freshness can be watched in a couple of minutes.
REFRESH_MAX_CADENCE_SECONDS=""

# --- Drive service account (docs/OPERATIONS.md §5) ---
# The identity users share Docs/folders with. Create with NO IAM roles (sharing
# is the grant). lib/googleAuth takes the FIRST that yields a usable key:
#   1. GOOGLE_SERVICE_ACCOUNT_JSON — the key JSON pasted inline
#   2. GOOGLE_APPLICATION_CREDENTIALS — a path to that same JSON on disk
# Set ONE of them. (Production sets neither — see the keyless block below.)
# The Workspace external-sharing gotcha is in docs/OPERATIONS.md §5.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPLICATION_CREDENTIALS=""

# --- Google Chat app (@AutoKnow ingestion; docs/OPERATIONS.md §6) ---
# The GCP project NUMBER (not id) — the audience of the JWTs Chat sends to
# /api/chat/events. Find it: gcloud projects describe <id> --format="value(projectNumber)"
GOOGLE_PROJECT_NUMBER=""

# --- Optional: admin/dev endpoints ---
# If set, /api/admin/seed requires this token via the x-admin-token header.
# If unset, those destructive ops are allowed only outside production.
ADMIN_TOKEN=""

# --- Required to WIPE/RE-SEED a non-test database ---
# Fail-closed guard against accidentally deleting production data: wiping or
# re-seeding refuses unless this equals the EXACT database name in DATABASE_URL
# (databases whose name ends in `_test` are always allowed — they are disposable).
# Leave unset to make destructive ops impossible; set it to your database's name
# (e.g. "autoknow") only in the environment where wiping that database is intended.
DESTRUCTIVE_DB_ALLOWED=""

# =============================================================================
# PRODUCTION ONLY — Terraform sets these on Cloud Run (infra/terraform/main.tf).
# Listed so nothing is invisible; leave them EMPTY locally.
# =============================================================================

# Auth.js's own public origin. Unset in a container, Auth.js falls back to the
# HOSTNAME (0.0.0.0:3000) and OAuth callbacks break with error=Configuration.
# Locally Auth.js infers it from the request, so leave this empty.
# (Auth.js reads this itself, never through process.env in our code — which is
# why tests/envSample.test.ts cannot discover it and allowlists it by name.)
AUTH_URL=""

# Keyless Google auth: names the runtime service account so lib/googleAuth can
# mint chat.bot / drive tokens for it via IAM Credentials (self-impersonation),
# with NO service-account key anywhere. Active only when K_SERVICE is also set,
# i.e. on Cloud Run — so setting it locally does nothing.
GOOGLE_SA_EMAIL=""

# The Workspace group users share Drive docs with — autoknow@<domain>, with the runtime
# SA as a member. Terraform creates the group and sets this on Cloud Run. It is the ONLY
# source for the share address, never derived from the SA email (they are different facts).
# Unset ⇒ the Sources page names the service account as a service account instead.
GOOGLE_SHARE_ADDRESS=""

# The Cloud Scheduler cron that drives GET /api/cron/refresh, told to the app rather than
# assumed by it (Terraform sets it from `var.cron_schedule`). lib/ingestBudget divides one
# daily Gemini budget by the cycles/day this implies, so a denser schedule the app cannot
# see multiplies real spend while the settings slider plots the old ceiling.
# Unset ⇒ hourly is assumed for the math, and the Sources page stops claiming a cadence.
REFRESH_CRON_SCHEDULE=""

# =============================================================================
# ESCAPE HATCHES — derived automatically; set only to override.
# =============================================================================

# Pin the per-worktree token that names the test DB and the e2e port instead of
# hashing the checkout path (tests/helpers/worktree.ts) — to share one DB across
# processes, or to pin a stable name in CI.
WORKTREE_ID=""

# Pin the base test database / e2e port block, bypassing the derivation entirely.
# TEST_DATABASE_URL is still forced to end in `_test` — the wipe guard keys on it —
# and both still take the per-worker `_w<n>` / `+n` suffix, which is not optional:
# two e2e workers on one database or one port wipe each other's fixtures.
TEST_DATABASE_URL=""
TEST_SERVER_PORT=""

# How many Playwright workers e2e runs, and therefore how many web servers and test
# databases it provisions (tests/helpers/worktree.ts). Defaults to 4 — the vCPU count
# of a CI runner. Lower it on a busy laptop; 1 makes the suite serial again.
E2E_WORKERS=""

# Next's build output directory. Resolves RELATIVE to the project root even when
# absolute — use a short name like `.next-preview` when running a second server.
NEXT_DIST_DIR=""

# Log every request path through src/proxy.ts. Any non-empty value enables it.
DEBUG_REQUESTS=""

# =============================================================================
# NEVER set these by hand — the platform injects them, and a stale hand-written
# value is worse than none: NODE_ENV (Next), CI (GitHub Actions),
# K_SERVICE (Cloud Run — how the app knows it is running there),
# GIT_SHA (the build; reported by /api/health).
# =============================================================================
