{
  "name": "autoknow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "sh scripts/dev/link-env.sh 2>/dev/null || true; if [ -f prisma/schema.prisma ]; then npm run db:generate; fi",
    "demo": "ts-node scripts/dev/demo.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e:build": "SKIP_BUILD_TYPECHECK=1 NEXT_DIST_DIR=.next-test next build",
    "test:e2e": "npm run test:e2e:build && playwright test --project=chromium --project=webkit",
    "test:e2e:chromium": "npm run test:e2e:build && playwright test --project=chromium",
    "test:e2e:webkit": "npm run test:e2e:build && playwright test --project=webkit",
    "test:e2e:ui": "npm run test:e2e:build && playwright test --ui",
    "test:e2e:screens": "npm run test:e2e:build && playwright test --project=screens",
    "evidence": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:e2e && npm run build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:test:clean": "ts-node scripts/db/clean-test-dbs.ts",
    "db:demo:clean": "ts-node scripts/db/clean-demo-dbs.ts",
    "docker:reap": "bash scripts/dev/docker-reap.sh",
    "docker:reap:apply": "bash scripts/dev/docker-reap.sh --yes",
    "clean:workspace": "npm run db:test:clean && npm run db:demo:clean && npm run docker:reap:apply",
    "db:embeddings:audit": "ts-node scripts/db/audit-embeddings.ts",
    "db:backfill:owner-person": "ts-node --compilerOptions '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' scripts/db/backfill-owner-person.ts",
    "db:backfill:affiliation-email": "ts-node --compilerOptions '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' scripts/db/backfill-affiliation-email.ts",
    "db:backfill:context-mentions": "ts-node --compilerOptions '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' -r ./scripts/db/allow-server-only.cjs scripts/db/backfill-context-mentions.ts",
    "db:check:email-conflicts": "ts-node --compilerOptions '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' scripts/db/check-email-conflicts.ts",
    "db:remediate:unmatched-owners": "ts-node --compilerOptions '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' scripts/db/remediate-unmatched-owners.ts",
    "db:remediate:conflicting-addresses": "ts-node --compilerOptions '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' scripts/db/remediate-conflicting-addresses.ts",
    "infra:plan": "scripts/infra/terraform.sh plan",
    "infra:apply": "scripts/infra/terraform.sh apply",
    "infra:output": "scripts/infra/terraform.sh output",
    "ci:disk-reclaim": "scripts/ci/disk-reclaim.sh",
    "ci:disk-report": "scripts/ci/disk-report.sh",
    "ci:disk-guard": "scripts/ci/disk-guard.sh",
    "ci:lint-migrations": "scripts/ci/lint-migrations.sh",
    "ci:lint-ordering": "scripts/ci/lint-change-ordering.sh",
    "ci:lint-compound": "scripts/ci/lint-compound.sh",
    "ci:migrate": "scripts/ci/migrate.sh",
    "ci:deploy": "scripts/ci/build-and-deploy.sh",
    "ci:harden-db": "scripts/db/harden.sh",
    "ci:backfill": "scripts/db/backfill.sh"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@mdxeditor/editor": "^4.0.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
