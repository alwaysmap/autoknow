{
  "name": "autoknow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "sh scripts/dev/link-env.sh 2>/dev/null || true; if [ -f prisma/schema.prisma ]; then npm run db:generate; fi",
    "demo": "ts-node scripts/dev/demo.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test --project=chromium --project=webkit",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:screens": "playwright test --project=screens",
    "evidence": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:e2e && npm run build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:test:clean": "ts-node scripts/db/clean-test-dbs.ts",
    "ci:lint-migrations": "scripts/ci/lint-migrations.sh",
    "ci:lint-ordering": "scripts/ci/lint-change-ordering.sh",
    "ci:migrate": "scripts/ci/migrate.sh",
    "ci:deploy": "scripts/ci/build-and-deploy.sh",
    "ci:harden-db": "scripts/db/harden.sh"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@mdxeditor/editor": "^4.0.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
