generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Partner {
  id                 Int                 @id @default(autoincrement())
  name               String
  typeId             Int?
  type               PartnerType?        @relation(fields: [typeId], references: [id])
  projects           Project[]
  currentEmployees   Person[]            @relation("CurrentPartner")
  personAffiliations PersonAffiliation[]
  states             PartnerState[]
  contextUrls        ContextUrl[]
  phaseInvolvements  PhasePartner[]
  leadPhases         Phase[]             @relation("PhaseLeadPartner")
  embedding          Unsupported("vector(768)")?
  website            String?
  internalDetailsUrl String?
  summary            String?
  googleTeam         Json?
  phone              String?
  // Region is part of a partner's identity — required (the header renders it as a
  // classification link; a region-less partner is a data bug).
  regionId           Int
  region             Region              @relation(fields: [regionId], references: [id])
}

enum ProjectLifecycle {
  active
  complete
  cancelled
}

model Region {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  partners Partner[]
}

model PartnerType {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  partners Partner[]
}

model Project {
  id                Int            @id @default(autoincrement())
  name              String
  partnerId         Int
  partner           Partner        @relation(fields: [partnerId], references: [id])
  phases            Phase[]
  contextUrls       ContextUrl[]
  isArchived        Boolean        @default(false)
  theNeedle         String         @default("Low")
  hillChartProgress Int            @default(0)
  sopDate           DateTime? // target SOP — month/year minimum, stored as month-end
  ownerName         String?
  volumeFirstYear   Int            @default(0)
  // Included Google products — which capacity this program brings online.
  hasGas            Boolean        @default(false) // Google Automotive Services
  hasGbi            Boolean        @default(false) // Google Built-In
  hasDigitalKey     Boolean        @default(false)
  hasAap            Boolean        @default(false) // Android Auto (projection)
  // Explicit lifecycle — Active/Complete/Cancelled are FACTS someone sets, not
  // inferences from progress. isArchived stays orthogonal (visibility): an
  // archived program keeps its lifecycle.
  lifecycle         ProjectLifecycle @default(active)
  states            ProjectState[]
  embedding         Unsupported("vector(768)")?
}

// Leadership summary for one scope (ecosystem / partner / program): risks, progress,
// themes, actions. Synthesized ONLY from stored data (state rows + ingested digests);
// never re-fetches original sources. `body` holds the structured sections with
// per-bullet citations back to exact in-app/source links. Cached append-only; a
// summary is stale when scope-relevant content is newer than generatedAt.
model Summary {
  id           Int      @id @default(autoincrement())
  scope        String // "ecosystem" | "partner" | "program"
  targetId     Int      @default(0) // partner/project id; 0 for ecosystem
  generatedAt  DateTime @default(now())
  trigger      String // "auto" | "manual"
  model        String // e.g. "gemini-flash-latest"
  windowStart  DateTime
  windowEnd    DateTime
  tldr         String
  body         Json // { sections: [{ key, bullets: [{ text, citations: [{ label, href, external }] }] }] }
  sourceCounts Json

  @@index([scope, targetId, generatedAt])
}

// The generation prompts, DB-resident so leadership language can be tuned without a
// deploy. Defaults live (readably) in src/lib/summaryPrompts.ts; a row here overrides.
model SummaryPrompt {
  scope     String   @id // "ecosystem" | "partner" | "program"
  prompt    String
  updatedAt DateTime @updatedAt
}

model Phase {
  id                 Int               @id @default(autoincrement())
  projectId          Int
  project            Project           @relation(fields: [projectId], references: [id])
  name               String

  // Self-referential relationship for the DAG
  dependencies       PhaseDependency[] @relation("PhaseDependencies")
  dependentOn        PhaseDependency[] @relation("PhaseDependents")

  states             PhaseState[]
  actionItems        ActionItem[]
  contextUrls        ContextUrl[]
  partners           PhasePartner[]
  people             PhasePerson[]
  forecastedDuration Int               @default(30)

  // Rich content copied from a PhaseTemplate at instantiation, then per-project editable.
  description        String? // markdown — exit outcome + typical activities
  googleFocus        String? // markdown — what Googlers/TSC focus on
  leadPartnerId      Int?    // concrete partner mapped from the template's leadRole
  leadPartner        Partner? @relation("PhaseLeadPartner", fields: [leadPartnerId], references: [id])
  isEndPhase         Boolean @default(false) // the program's single convergence point
}

// Real per-phase partner attribution: which partners are involved in a phase's work.
// A partner may OWN a program (Project.partnerId) or merely be INVOLVED via these rows.
model PhasePartner {
  id        Int     @id @default(autoincrement())
  phaseId   Int
  phase     Phase   @relation(fields: [phaseId], references: [id])
  partnerId Int
  partner   Partner @relation(fields: [partnerId], references: [id])
  role      String? // e.g. "Supplier", "Silicon", "Integrator"

  @@unique([phaseId, partnerId])
}

// Real per-phase people attribution: which individuals are involved in a phase's
// work, with an optional role. Mirrors PhasePartner.
model PhasePerson {
  id       Int    @id @default(autoincrement())
  phaseId  Int
  phase    Phase  @relation(fields: [phaseId], references: [id])
  personId Int
  person   Person @relation(fields: [personId], references: [id])
  role     String? // e.g. "FAE", "TPM", "Audio lead"

  @@unique([phaseId, personId])
}

model PhaseDependency {
  id               Int   @id @default(autoincrement())
  phaseId          Int
  phase            Phase @relation("PhaseDependencies", fields: [phaseId], references: [id])
  dependsOnPhaseId Int
  dependsOnPhase   Phase @relation("PhaseDependents", fields: [dependsOnPhaseId], references: [id])
}

model PhaseState {
  id                Int      @id @default(autoincrement())
  phaseId           Int
  phase             Phase    @relation(fields: [phaseId], references: [id])
  timestamp         DateTime @default(now())
  
  status            String   // Derived from hillChartProgress (lib/phase.hillStatus): "Not Started" (0),
                             // "In Progress", "Done" (100). Never user-picked; display always re-derives
                             // from progress. Legacy rows may hold "Active WIP"/"Finished"/"Skipped".
  hillChartProgress Int?     // 0-100
  theNeedle         String?  // Risk level inference
  isStagnant        Boolean  @default(false)
  notes             String?
  source            String?
  sourceUrl         String?
}

model ActionItem {
  id                 Int      @id @default(autoincrement())
  phaseId            Int
  phase              Phase    @relation(fields: [phaseId], references: [id])
  description        String
  assignedTo         String?  // Keep for backward compatibility/LDAP text
  assignedToPersonId Int?
  assignedToPerson   Person?  @relation(fields: [assignedToPersonId], references: [id])
  status             String   // "Pending", "Completed"
  nextStep           String   @default("Undecided") // "Undecided", "Resolved", "Partner", "Googler"
  linkUrl            String?  // External system of record link (Buganizer, Google Doc)
  source             String?
  sourceUrl          String?
  createdAt          DateTime @default(now())
}

model ContextUrl {
  id           Int      @id @default(autoincrement())
  // Ingested context attaches to whichever entity it is about. All optional so an
  // AI classifier can place a pasted doc against a project, partner, and/or phase.
  projectId    Int?
  project      Project? @relation(fields: [projectId], references: [id])
  partnerId    Int?
  partner      Partner? @relation(fields: [partnerId], references: [id])
  phaseId      Int?
  phase        Phase?   @relation(fields: [phaseId], references: [id])
  url          String
  type         String   // "Chat", "Doc", "Gerrit"
  title        String?
  ingestedText String?  // the AI-distilled digest, not the raw document
  createdAt    DateTime @default(now())
  embedding    Unsupported("vector(768)")?

  // Freshness tracking (docs/INGEST_FRESHNESS_PLAN.md). Two modes: snapshot rows are
  // never re-checked; watched rows are re-checked on their connector's cadence until
  // frozen (always with a reason). sourceRef is the canonical identity used for
  // dedupe — one source, one row, one anchor.
  mode          String    @default("snapshot") // snapshot | watched
  modeSource    String    @default("inferred") // inferred | user
  sourceRef     String?   @unique // Drive fileId / Chat thread / normalized URL
  sourceVersion String?   // Drive version / ETag / patchset
  contentHash   String?   // sha256 of normalized fetched text
  sourceStatus  String?   // open | resolved | not-applicable (digest-extracted)
  addedBy       String?   // who brought this in: user handle, or the Drive sharer
  lastCheckedAt DateTime?
  lastChangedAt DateTime?
  frozenAt      DateTime?
  frozenReason  String?   // resolved | access-revoked | deleted | auth-required | user-paused
  revisions     ContextRevision[]

  @@index([mode, frozenAt])
}

// One row per re-distillation of a watched source — append-only history matching the
// State-row pattern. The parent's ingestedText always holds the LATEST digest.
model ContextRevision {
  id            Int        @id @default(autoincrement())
  contextUrlId  Int
  contextUrl    ContextUrl @relation(fields: [contextUrlId], references: [id])
  checkedAt     DateTime   @default(now())
  sourceVersion String?
  contentHash   String
  sourceStatus  String?
  digest        String // full digest at this revision
  delta         String? // "what's new vs. previous digest" bullets; null for initial ingest

  @@index([contextUrlId, checkedAt])
}

// One row per external delta feed (e.g. Drive changes pageToken).
model SyncCursor {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Person {
  id               Int                 @id @default(autoincrement())
  name             String
  email            String              @unique
  currentPartnerId Int
  currentPartner   Partner             @relation("CurrentPartner", fields: [currentPartnerId], references: [id])
  notes            String?
  affiliations     PersonAffiliation[]
  actionItems      ActionItem[]
  phaseInvolvements PhasePerson[]
  embedding        Unsupported("vector(768)")?
}

// Program templates (PHASE_TEMPLATES_PLAN): a reusable phase DAG with rich per-phase
// content. Built-ins are seeded from lib/builtinTemplates and are clone-only.
model ProgramTemplate {
  id          Int             @id @default(autoincrement())
  name        String
  description String? // markdown, program-level
  isBuiltIn   Boolean         @default(false) // seeded; clone-only, not user-deletable
  createdBy   String?
  createdAt   DateTime        @default(now())
  phases      PhaseTemplate[]
}

model PhaseTemplate {
  id            Int                @id @default(autoincrement())
  templateId    Int
  template      ProgramTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name          String
  description   String? // markdown — exit outcome + typical activities
  googleFocus   String? // markdown — what Googlers/TSC focus on
  leadRole      String? // "OEM" | "Silicon vendor" | "Tier 1" | "Google" | "3PL" | "Hypervisor vendor"
  durationWeeks Int                @default(4)
  isEndPhase    Boolean            @default(false) // the single join/deliverable node
  sortOrder     Int                @default(0) // stable display order
  dependsOn     PhaseTemplateDep[] @relation("PT_from")
  dependents    PhaseTemplateDep[] @relation("PT_to")
}

model PhaseTemplateDep {
  // DAG among phase-templates (edge = "depends on upstream")
  id              Int           @id @default(autoincrement())
  phaseTemplateId Int
  phaseTemplate   PhaseTemplate @relation("PT_from", fields: [phaseTemplateId], references: [id], onDelete: Cascade)
  dependsOnId     Int
  dependsOn       PhaseTemplate @relation("PT_to", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([phaseTemplateId, dependsOnId])
}

model PersonAffiliation {
  id        Int       @id @default(autoincrement())
  personId  Int
  person    Person    @relation(fields: [personId], references: [id])
  partnerId Int
  partner   Partner   @relation(fields: [partnerId], references: [id])
  role      String
  startDate DateTime
  endDate   DateTime? // null means current
}

model ProjectState {
  id                Int      @id @default(autoincrement())
  projectId         Int
  project           Project  @relation(fields: [projectId], references: [id])
  timestamp         DateTime @default(now())
  theNeedle         String
  hillChartProgress Int
  notes             String?
  source            String?
  sourceUrl         String?
}

model PartnerState {
  id                Int      @id @default(autoincrement())
  partnerId         Int
  partner           Partner  @relation(fields: [partnerId], references: [id])
  timestamp         DateTime @default(now())
  theNeedle         String   @default("Low") // "Low", "Medium", "High", "Critical"
  hillChartProgress Int      @default(0)     // 0-100
  // Relationship health on a discrete 1 (critical) .. 7 (exemplary) scale — partner
  // health is NOT a needle/progress metric. theNeedle stays derived-in-sync so the
  // activity feed and legacy filters keep working; null on pre-scale rows.
  relationshipScore Int?
  // Every relationship update carries its written note (the dialog requires one;
  // the schema agrees).
  notes             String
  source            String?
  sourceUrl         String?
}

