generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // btree_gist is what lets a GiST exclusion constraint compare scalars (`=` on text,
  // `<>` on an int) alongside a range — see PersonAffiliation's unique-at-an-instant
  // constraint (#127 E9). Declared here so `migrate dev` reports drift if the extension
  // is ever missing; the migration that needs it creates it itself.
  extensions = [vector, btree_gist]
}

// Semantic search (lib/search, lib/vector) scans the vector(768) columns exactly —
// correct and fast at the current scale (hundreds of rows). Prisma can't express an
// ANN index on an Unsupported() column; once ContextUrl passes ~10k rows, add one via
// a raw statement (like ensureVectorExtension), e.g.:
//   CREATE INDEX IF NOT EXISTS context_embedding_hnsw
//     ON "ContextUrl" USING hnsw (embedding vector_cosine_ops);
// Note the `embedding IS NOT NULL OR lex > 0` OR-filter in branchSql will defeat a
// pure index scan — split the lexical and semantic branches if latency shows up.

model Partner {
  id                 Int                 @id @default(autoincrement())
  name               String
  typeId             Int?
  type               PartnerType?        @relation(fields: [typeId], references: [id])
  projects           Project[]
  currentEmployees   Person[]            @relation("CurrentPartner")
  personAffiliations PersonAffiliation[]
  states             PartnerState[]
  contextUrls        ContextUrl[]
  phaseInvolvements  PhasePartner[]
  leadPhases         Phase[]             @relation("PhaseLeadPartner")
  embedding          Unsupported("vector(768)")?
  website            String?
  internalDetailsUrl String?
  summary            String?
  phone              String?
  // Region is part of a partner's identity — required (the header renders it as a
  // classification link; a region-less partner is a data bug).
  regionId           Int
  region             Region              @relation(fields: [regionId], references: [id])
}

enum ProjectLifecycle {
  active
  complete
  cancelled
}

model Region {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  partners Partner[]
}

model PartnerType {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  partners Partner[]
}

model Project {
  id                Int            @id @default(autoincrement())
  name              String
  partnerId         Int
  partner           Partner        @relation(fields: [partnerId], references: [id])
  phases            Phase[]
  contextUrls       ContextUrl[]
  isArchived        Boolean        @default(false)
  theNeedle         String         @default("Low")
  hillChartProgress Int            @default(0)
  sopDate           DateTime? // target SOP — month/year minimum, stored as month-end
  // The assigned Googler, twice over — the same shape ActionItem.assignedTo /
  // assignedToPersonId has carried since 0_init. `ownerPersonId` is the entity
  // reference that survives the owner changing address (#124 Class 4), and since
  // #127 E7 it is what EVERY reader goes through. `ownerName` holds the canonical
  // email as TEXT and is now legacy: still written (the dual-write continues — E7 was
  // the read-side contract step, not the column drop), still what the backfill and the
  // unmatched-owner remediation arm reason about, but no longer read for display.
  // IF it is ever dropped that is a separate expand→backfill→contract merge — but the
  // question was asked and answered, below. No path that ASSIGNS an
  // owner can write one without the other — `requireOwner` in lib/owner hands back
  // exactly this pair and nothing hands back the email alone. Deleting the person
  // clears the id and KEEPS the text, so the row still records who used to own it —
  // an audit trail, not a display fallback: the program now reads as unowned and asks
  // for a new TEL, which is the honest state once the human is gone.
  //
  // KEPT, decided 2026-07-28 (bead autoknow-p78, which existed to ASK rather than to
  // assume). The case for dropping was that a mutable address stored as free text is
  // the shape #124 Class 4 is about, and that keeping it invites a future reader. That
  // second worry is already answered in software rather than in prose: the `ownerText`
  // eslint family blocks a read through four selectors (member, Prisma key, quoted key,
  // raw-SQL template) and is proved firing. What dropping would cost is not
  // hypothetical — the audit trail above is written by `deletePerson` on purpose, and
  // the two arms named above still reason about this column. A
  // write-only column with an enforced no-read guard is a smaller liability than
  // deleting the only record of who used to own a program. Re-open the question if the
  // lint family is ever weakened, which is the condition that reverses the argument.
  ownerName         String?
  ownerPersonId     Int?
  // Back-relation: Person.ownedProjects. Named here because a grep for the forward
  // field is not the set of readers (docs/knowledge/a-prisma-back-relation-hides-the-field-you-are-grepping-for.md).
  ownerPerson       Person?        @relation(fields: [ownerPersonId], references: [id])
  volumeFirstYear   Int            @default(0)
  // Included Google products — which capacity this program brings online.
  hasGas            Boolean        @default(false) // Google Automotive Services
  hasGbi            Boolean        @default(false) // Google Built-In
  hasDigitalKey     Boolean        @default(false)
  hasAap            Boolean        @default(false) // Android Auto (projection)
  // Explicit lifecycle — Active/Complete/Cancelled are FACTS someone sets, not
  // inferences from progress. isArchived stays orthogonal (visibility): an
  // archived program keeps its lifecycle.
  lifecycle         ProjectLifecycle @default(active)
  states            ProjectState[]
  embedding         Unsupported("vector(768)")?

  // The dominant read behind the FK is "programs owned by this person" (the person
  // page), and Postgres does not auto-index FK columns.
  @@index([ownerPersonId])
  // The same reasoning as `@@index([ownerPersonId])` above, missed when that one was
  // added (20260726232108): partnerId is the OTHER un-auto-indexed FK, and it is read
  // harder. The partner page's program list is exactly `where partnerId order by name`
  // (lib/partnerPrograms), so the composite serves filter and sort in one scan; partnerId
  // alone is the prefix, which is what lib/partnerDeletion's blocker count and
  // lib/search's partner-scoped program reads use. Postgres also scans this to ENFORCE
  // the RESTRICT on every partner delete, so the write path pays for its absence too.
  @@index([partnerId, name])
}

// Leadership summary for one scope (ecosystem / partner / program): risks, progress,
// themes, actions. Synthesized ONLY from stored data (state rows + ingested digests);
// never re-fetches original sources. `body` holds the structured sections with
// per-bullet citations back to exact in-app/source links. Cached append-only; a
// summary is stale when scope-relevant content is newer than generatedAt.
model Summary {
  id           Int      @id @default(autoincrement())
  scope        String // "ecosystem" | "partner" | "program"
  targetId     Int      @default(0) // partner/project id; 0 for ecosystem
  generatedAt  DateTime @default(now())
  trigger      String // "auto" | "manual"
  model        String // e.g. "gemini-flash-latest"
  windowStart  DateTime
  windowEnd    DateTime
  tldr         String
  body         Json // { sections: [{ key, bullets: [{ text, citations: [{ label, href, external }] }] }] }
  sourceCounts Json

  @@index([scope, targetId, generatedAt])
}

// The generation prompts, DB-resident so leadership language can be tuned without a
// deploy. Defaults live (readably) in src/lib/summaryPrompts.ts; a row here overrides.
model SummaryPrompt {
  scope     String   @id // "ecosystem" | "partner" | "program"
  prompt    String
  updatedAt DateTime @updatedAt
}

model Phase {
  id                 Int               @id @default(autoincrement())
  projectId          Int
  project            Project           @relation(fields: [projectId], references: [id])
  name               String

  // Self-referential relationship for the DAG
  dependencies       PhaseDependency[] @relation("PhaseDependencies")
  dependentOn        PhaseDependency[] @relation("PhaseDependents")

  states             PhaseState[]
  actionItems        ActionItem[]
  contextUrls        ContextUrl[]
  partners           PhasePartner[]
  people             PhasePerson[]
  forecastedDuration Int               @default(30)

  // Rich content copied from a PhaseTemplate at instantiation, then per-project editable.
  description        String? // markdown — exit outcome + typical activities
  googleFocus        String? // markdown — what Googlers/TSC focus on
  leadPartnerId      Int?    // concrete partner mapped from the template's leadRole
  leadPartner        Partner? @relation("PhaseLeadPartner", fields: [leadPartnerId], references: [id])
  isEndPhase         Boolean @default(false) // the program's single convergence point

  // Explicit "work has begun" marker (cycle time: separates wait from active time).
  // Set by the Active toggle; takes precedence over the derived first-progress-update
  // timestamp, because work often starts (at a partner) well before the first update.
  startedAt          DateTime?

  @@index([projectId])
}

// Real per-phase partner attribution: which partners are involved in a phase's work.
// A partner may OWN a program (Project.partnerId) or merely be INVOLVED via these rows.
model PhasePartner {
  id        Int     @id @default(autoincrement())
  phaseId   Int
  phase     Phase   @relation(fields: [phaseId], references: [id])
  partnerId Int
  partner   Partner @relation(fields: [partnerId], references: [id])
  role      String? // e.g. "Supplier", "Silicon", "Integrator"

  @@unique([phaseId, partnerId])
  // Partner pages ask "which phases involve this partner" — the unique above only
  // serves phaseId-leading lookups.
  @@index([partnerId])
}

// Real per-phase people attribution: which individuals are involved in a phase's
// work, with an optional role. Mirrors PhasePartner.
model PhasePerson {
  id       Int    @id @default(autoincrement())
  phaseId  Int
  phase    Phase  @relation(fields: [phaseId], references: [id])
  personId Int
  person   Person @relation(fields: [personId], references: [id])
  role     String? // e.g. "FAE", "TPM", "Audio lead"

  @@unique([phaseId, personId])
  @@index([personId])
}

model PhaseDependency {
  id               Int   @id @default(autoincrement())
  phaseId          Int
  phase            Phase @relation("PhaseDependencies", fields: [phaseId], references: [id])
  dependsOnPhaseId Int
  dependsOnPhase   Phase @relation("PhaseDependents", fields: [dependsOnPhaseId], references: [id])

  // One edge per pair — the DB backstop for the check-then-create race in
  // actions/dependencies (its template twin PhaseTemplateDep always had this).
  @@unique([phaseId, dependsOnPhaseId])
  @@index([dependsOnPhaseId])
}

model PhaseState {
  id                Int      @id @default(autoincrement())
  phaseId           Int
  phase             Phase    @relation(fields: [phaseId], references: [id])
  timestamp         DateTime @default(now())
  
  status            String   // Derived from hillChartProgress (lib/phase.hillStatus): "Not Started" (0),
                             // "In Progress", "Done" (100). Never user-picked; display always re-derives
                             // from progress. Legacy rows may hold "Active WIP"/"Finished"/"Skipped".
  hillChartProgress Int?     // 0-100
  theNeedle         String?  // Risk level inference
  isStagnant        Boolean  @default(false)
  notes             String?
  source            String?
  sourceUrl         String?

  // The dominant read is "latest state for this phase" (orderBy timestamp desc,
  // take 1) — Postgres does not auto-index FK columns.
  @@index([phaseId, timestamp])
  // The UNSCOPED reads, which the composite above cannot serve: with no phaseId
  // predicate its leading column is unconstrained, so Postgres sorts the whole table.
  // Two callers — lib/summaries' ecosystem staleness probe and lib/activity's ecosystem
  // feed. This is the table where it matters most, because it is append-only and the
  // fastest-growing in the schema. Migration 20260729015546 has the measurement, and why
  // the probe's HEALTHY case is its expensive one.
  //
  // NOT the redundancy `drop_redundant_affiliation_indexes` removed: that dropped
  // single-column indexes that were strict PREFIXES of a composite. `timestamp` is this
  // composite's SUFFIX, which no prefix rule reaches — so do not "align" the two on sight.
  @@index([timestamp])
}

model ActionItem {
  id                 Int      @id @default(autoincrement())
  phaseId            Int
  phase              Phase    @relation(fields: [phaseId], references: [id])
  description        String
  assignedTo         String?  // Keep for backward compatibility/LDAP text
  assignedToPersonId Int?
  assignedToPerson   Person?  @relation(fields: [assignedToPersonId], references: [id])
  status             String   // "Pending", "Completed"
  nextStep           String   @default("Undecided") // "Undecided", "Resolved", "Partner", "Googler"
  linkUrl            String?  // External system of record link (Buganizer, Google Doc)
  source             String?
  sourceUrl          String?
  createdAt          DateTime @default(now())

  @@index([phaseId])
  @@index([assignedToPersonId])
}

model ContextUrl {
  id           Int      @id @default(autoincrement())
  // Ingested context attaches to whichever entity it is about. All optional so an
  // AI classifier can place a pasted doc against a project, partner, and/or phase.
  projectId    Int?
  project      Project? @relation(fields: [projectId], references: [id])
  partnerId    Int?
  partner      Partner? @relation(fields: [partnerId], references: [id])
  phaseId      Int?
  phase        Phase?   @relation(fields: [phaseId], references: [id])
  url          String
  type         String   // "Chat", "Doc", "Gerrit"
  title        String?
  ingestedText String?  // the AI-distilled digest, not the raw document
  createdAt    DateTime @default(now())
  embedding    Unsupported("vector(768)")?

  // Freshness tracking (docs/INGEST_FRESHNESS_PLAN.md). Two modes: snapshot rows are
  // never re-checked; watched rows are re-checked on their connector's cadence until
  // frozen (always with a reason). sourceRef is the canonical identity used for
  // dedupe — one source, one row, one anchor.
  mode          String    @default("snapshot") // snapshot | watched
  modeSource    String    @default("inferred") // inferred | user
  sourceRef     String?   @unique // Drive fileId / Chat thread / normalized URL
  sourceVersion String?   // Drive version / ETag / patchset
  contentHash   String?   // sha256 of normalized fetched text
  sourceStatus  String?   // open | resolved | not-applicable (digest-extracted)
  // Lossy: the fetched text was longer than gemini.MAX_DOC_CHARS (30K), so everything past
  // that never reached the digest or the embedding and is not searchable. One source = one
  // digest = one embedding (no chunking — the scaling ADR's decision 4), so this is a
  // standing property of the row, surfaced on Manage → Sources rather than left silent
  // (decision 3, #56). Re-evaluated on every refresh.
  truncated     Boolean   @default(false)
  addedBy       String?   // who brought this in: user handle, or the Drive sharer
  lastCheckedAt DateTime?
  lastChangedAt DateTime?
  frozenAt      DateTime?
  frozenReason  String?   // resolved | access-revoked | deleted | auth-required | user-paused
  revisions     ContextRevision[]

  // The cron's due-source query: filter on (mode, frozenAt), order by lastCheckedAt,
  // LIMIT the budget (#58). Extending the pair with lastCheckedAt lets Postgres serve the
  // whole statement from the index instead of sorting every watched row to take ten.
  @@index([mode, frozenAt, lastCheckedAt])
  @@index([projectId])
  @@index([partnerId])
  @@index([phaseId])
  @@index([createdAt])
}

// One row per re-distillation of a watched source — append-only history matching the
// State-row pattern. The parent's ingestedText always holds the LATEST digest.
model ContextRevision {
  id            Int        @id @default(autoincrement())
  contextUrlId  Int
  contextUrl    ContextUrl @relation(fields: [contextUrlId], references: [id])
  checkedAt     DateTime   @default(now())
  sourceVersion String?
  contentHash   String
  sourceStatus  String?
  digest        String // full digest at this revision
  delta         String? // "what's new vs. previous digest" bullets; null for initial ingest

  @@index([contextUrlId, checkedAt])
}

// One row per external delta feed (e.g. Drive changes pageToken).
model SyncCursor {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// #38 ingestion health ([ADR: Ingestion health is a serverless signal, not a growing
// table](adr/2026-07-23-ingestion-health-is-a-serverless-signal-not-a-growing-table.md)):
// the LATEST cron cycle's report, upserted in place on a fixed key — exactly ONE row,
// O(1), never O(cycles). The full time-series lives in Cloud Logging, not here; this
// row is only what the in-app health card reads. Combines the Drive sweep and the web
// refresh cycle, which run in one cron invocation (api/cron/refresh).
model IngestionCycleSummary {
  key   String   @id @default("latest") // singleton — always upserted, never inserted
  ranAt DateTime @default(now())
  // Drive sweep (runDriveSync / DriveSyncReport)
  driveConfigured   Boolean @default(false)
  sharedSeen        Int     @default(0)
  discovered        Int     @default(0)
  refreshed         Int     @default(0)
  skippedOtherTypes Int     @default(0) // shared but not a Google Doc — reported, not ingested
  skippedTooDeep    Int     @default(0) // beyond MAX_FOLDER_DEPTH — reported, not ingested
  driveErrors       Int     @default(0)
  // Web refresh cycle (runRefreshCycle / CycleReport)
  due          Int @default(0)
  checked      Int @default(0)
  changed      Int @default(0)
  frozen       Int @default(0)
  errors       Int @default(0)
  skippedDrive Int @default(0)
  // The number the drain alarm watches: work that was due/discoverable this cycle but
  // exceeded the per-cycle caps and carried to the next. Sustained > 0 across cycles is
  // the §6 "the simple design stopped fitting" trigger — surfaced as evidence.
  backlog Int @default(0)
  // Honest degradation (AGENTS lesson 5): the cycle stopped early on a Gemini quota
  // error (429 / RESOURCE_EXHAUSTED) rather than burning the rest of the batch.
  quotaStopped Boolean @default(false)
}

// #38: a Drive file shared with the app but NOT ingested, and why — so sharing never
// silently looks like it worked (AGENTS lesson 5). The natural key is the Drive fileId
// (one row per file); the set is bounded by what is CURRENTLY shared and pruned every
// sweep (a file that stops being shared, or becomes ingestable, drops out). O(corpus),
// never O(time) — this is a live picture of "what's shared-but-skipped", not a log.
model SkippedSource {
  fileId      String   @id
  name        String
  mimeType    String
  reason      String // unsupported-type | beyond-folder-depth
  sharedBy    String? // Drive sharingUser email/display, when Drive tells us
  folderDepth Int? // depth it was discovered at (for beyond-folder-depth)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@index([reason])
}

// #38: admin-tunable ingestion budget — the single knob that keeps free-tier Gemini
// usage under control (this deployment runs on the Gemini free tier and must not be
// billed). The per-cycle ingest caps are DERIVED from dailyReingestBudgetDocs (see
// lib/ingestBudget), so the daily Gemini request ceiling is bounded by construction —
// no live meter needed to stay safe. freeTierRequestsPerDay is the reference line the
// settings slider draws its "you'll exceed the free tier past here" marker against;
// it defaults conservatively and is meant to be tuned to the project's actual AI Studio
// quota (ai.google.dev/gemini-api/docs/rate-limits), because Google changes the numbers.
// Singleton (fixed key), like SummaryPrompt.
model IngestionSettings {
  key                     String   @id @default("default")
  dailyReingestBudgetDocs Int      @default(60) // documents (re)ingested/day; caps derive from this
  freeTierRequestsPerDay  Int      @default(250) // Gemini free-tier requests/day — VERIFY against your quota
  updatedAt               DateTime @updatedAt
}

model Person {
  id               Int                 @id @default(autoincrement())
  name             String
  // NOT `@unique` since #127 E9, and the removal is the point rather than a relaxation.
  // `@unique` said "one address, one human, forever", which is false: addresses are
  // recycled, and a person who leaves keeps the row that quotes theirs. What is actually
  // true is UNIQUE AT AN INSTANT — no two people hold one address at the same moment —
  // and that is a statement about employment PERIODS, which no column-level constraint
  // can make. It lives on PersonAffiliation as an EXCLUDE constraint (below).
  //
  // This column is the CURRENT canonical address, kept canonical: lower-cased and
  // trimmed on write (lib/schemas, via `normalizeAddress`) and by the E9 migration for
  // every row that predates it, so a DB-level `=` means the same thing as the app's.
  email            String
  currentPartnerId Int
  currentPartner   Partner             @relation("CurrentPartner", fields: [currentPartnerId], references: [id])
  notes            String?
  affiliations     PersonAffiliation[]
  actionItems      ActionItem[]
  ownedProjects    Project[] // back-relation of Project.ownerPersonId (#127 E6)
  phaseInvolvements PhasePerson[]
  embedding        Unsupported("vector(768)")?

  // E9 dropped `Person_email_key` when it dropped `@unique` — correctly, since the
  // uniqueness claim was false — but the READER survived the constraint: the duplicate
  // check on every person creation is `findFirst({ where: { email } })`
  // (app/actions/people). This restores the index without restoring the claim, and it is
  // the plain-`=` index only: the ILIKE/`mode:'insensitive'` lookups in lib/personDirectory
  // and app/me cannot use a plain btree and are deliberately left to the seq scan the
  // column comment above already reasons about.
  @@index([email])
  // Unindexed FK, same as Project.partnerId: lib/partnerDeletion counts people at a
  // partner to decide whether the delete is blocked, and Postgres scans this to enforce
  // the RESTRICT itself.
  @@index([currentPartnerId])
}

// Program templates (PHASE_TEMPLATES_PLAN): a reusable phase DAG with rich per-phase
// content. Built-ins are seeded from lib/builtinTemplates and are clone-only.
model ProgramTemplate {
  id          Int             @id @default(autoincrement())
  name        String
  description String? // markdown, program-level
  isBuiltIn   Boolean         @default(false) // seeded; clone-only, not user-deletable
  createdBy   String?
  createdAt   DateTime        @default(now())
  phases      PhaseTemplate[]

  // Backstop for the concurrent built-in seeding race in lib/programTemplates —
  // and duplicate template names within a tier are a data bug anyway.
  @@unique([name, isBuiltIn])
}

model PhaseTemplate {
  id            Int                @id @default(autoincrement())
  templateId    Int
  template      ProgramTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name          String
  description   String? // markdown — exit outcome + typical activities
  googleFocus   String? // markdown — what Googlers/TSC focus on
  leadRole      String? // "OEM" | "Silicon vendor" | "Tier 1" | "Google" | "3PL" | "Hypervisor vendor"
  durationWeeks Int                @default(4)
  isEndPhase    Boolean            @default(false) // the single join/deliverable node
  sortOrder     Int                @default(0) // stable display order
  dependsOn     PhaseTemplateDep[] @relation("PT_from")
  dependents    PhaseTemplateDep[] @relation("PT_to")
}

model PhaseTemplateDep {
  // DAG among phase-templates (edge = "depends on upstream")
  id              Int           @id @default(autoincrement())
  phaseTemplateId Int
  phaseTemplate   PhaseTemplate @relation("PT_from", fields: [phaseTemplateId], references: [id], onDelete: Cascade)
  dependsOnId     Int
  dependsOn       PhaseTemplate @relation("PT_to", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([phaseTemplateId, dependsOnId])
}

model PersonAffiliation {
  id        Int       @id @default(autoincrement())
  personId  Int
  person    Person    @relation(fields: [personId], references: [id])
  partnerId Int
  partner   Partner   @relation(fields: [partnerId], references: [id])
  role      String
  startDate DateTime
  endDate   DateTime? // null means current
  // The address held DURING this period (#124 §2, #127 E8). An email belongs to a JOB,
  // not to a human: leaving Qualcomm for Google means a new address, and a mention
  // written in 2025 quotes the old one forever. `Person.email` stays the CURRENT
  // canonical address; this column is what makes a past address still resolve to the
  // human who held it — #124 Class 4.
  //
  // NULLABLE, and it stays nullable: nothing knows what address somebody used at a
  // company they left before this column existed. `db:backfill:affiliation-email` fills
  // in only the period covering the run instant (the one `Person.email` demonstrably
  // belongs to) and leaves every other period NULL with a line in its report — NULL
  // means "not recorded", never "no address". `lib/people`'s matcher skips nulls.
  //
  // UNIQUE AT AN INSTANT, DB-enforced (#127 E9, spec #124 §2). Prisma cannot express an
  // exclusion constraint, so the migration writes it by hand and this comment is the
  // only place the schema says it exists:
  //
  //   CONSTRAINT "PersonAffiliation_email_unique_at_an_instant"
  //     EXCLUDE USING gist (lower(email) WITH =, "personId" WITH <>,
  //                         tsrange("startDate", "endDate") WITH &&)
  //     WHERE (email IS NOT NULL AND (endDate IS NULL OR endDate > startDate))
  //
  // Read it as: two DIFFERENT people may not have recorded the same address over
  // overlapping periods. The `WHERE` exempts rows that name nobody at any moment — a
  // NULL address says nothing, and a period ending at or before its own start covers no
  // instant (`tsrange` is not even constructible for an inverted one). `lower()` because
  // the app's notion of equality is case-insensitive (`normalizeAddress`) and a DB-level
  // `=` is not. `tsrange` is
  // half-open `[)`, which is the interval convention the whole of #124 uses, and an open
  // period (`endDate` NULL) becomes unbounded above, which is what "still there" means.
  // `personId WITH <>` because one person's own periods overlapping is a DIFFERENT
  // defect with a different fix (bead autoknow-2of, at the mutation boundary) — folding
  // it in here would make one constraint answer two questions and report the wrong one.
  email     String?

  // There is deliberately no single-column ("personId") or ("partnerId") index here.
  // Both existed until bead autoknow-4y3 (migration
  // 20260728202122_drop_redundant_affiliation_indexes)
  // and were dropped once E5 was healthy in prod: each is a strict PREFIX of the
  // corresponding composite below, so Postgres serves from the composite every lookup
  // the single served, and keeping them bought nothing but write amplification on every
  // insert and move. Re-adding one is a regression, not a safety net — if a plan ever
  // seems to want one, the answer is an EXPLAIN of the composite first.
  //
  // As-of lookups (#127 E4, spec #124 §5). `endDate` is nullable, so the predicate
  // is `startDate < d AND (endDate IS NULL OR endDate >= d)` — NOT a clean half-open
  // range, and the two trailing columns earn their place for different reasons:
  //   startDate is an index BOUND (it lands in Index Cond).
  //   endDate is NOT, and cannot be: `IS NULL OR >=` is not an indexable boundary.
  //     It rides along so a resolver selecting only these columns gets an Index
  //     Only Scan and evaluates that filter without touching the heap.
  // Verified by EXPLAIN, not assumed — forcing the plan gives
  // `Index Cond: personId = .. AND startDate < ..` with `Filter: endDate IS NULL
  // OR endDate >= ..`, and `Index Only Scan` once the select list stays inside the
  // index. Widen or reorder these and re-run that EXPLAIN before believing a
  // claim about which half is a bound.
  // `d` is the first instant of the day AFTER the as-of date (autoknow-yid made the
  // predicate day-granular). The plan shape is UNCHANGED by that: the bound is still a
  // bare `startDate` compared against a parameter, which is exactly why the fix moved
  // the boundary into the parameter instead of wrapping the column in `date_trunc`.
  @@index([personId, startDate, endDate])
  @@index([partnerId, startDate, endDate])
  // Resolution now asks this table "who has EVER held this address" (#127 E8,
  // lib/personDirectory), which without an index is a full scan of a table that grows
  // as people × jobs — and it runs on every page that renders a stored person string.
  // Equality is what this serves: the exact-address tier lands in Index Cond. The
  // local-part tier is `ILIKE 'handle@%'`, which no btree in a non-C collation can
  // answer, so it stays a scan — the same as the `Person` arm beside it in
  // lib/personDirectory, and honest at hundreds of rows. Do not "fix" that with a
  // functional index without EXPLAIN saying the scan actually costs something.
  @@index([email])
}

model ProjectState {
  id                Int      @id @default(autoincrement())
  projectId         Int
  project           Project  @relation(fields: [projectId], references: [id])
  timestamp         DateTime @default(now())
  theNeedle         String
  hillChartProgress Int
  notes             String?
  source            String?
  sourceUrl         String?

  @@index([projectId, timestamp])
  // The unscoped reads the composite cannot serve: lib/summaries' ecosystem staleness
  // probe and lib/activity's ecosystem feed, the same two that motivate the identical
  // index on PhaseState. Migration 20260729015546 carries the full account.
  @@index([timestamp])
}

model PartnerState {
  id                Int      @id @default(autoincrement())
  partnerId         Int
  partner           Partner  @relation(fields: [partnerId], references: [id])
  timestamp         DateTime @default(now())
  theNeedle         String   @default("Low") // "Low", "Medium", "High", "Critical"
  hillChartProgress Int      @default(0)     // 0-100
  // Relationship health on a discrete 1 (critical) .. 5 (exemplary) scale (see
  // lib/relationship.ts, the authority) — partner health is NOT a needle/progress
  // metric. theNeedle stays derived-in-sync so the activity feed and legacy filters
  // keep working; null on pre-scale rows.
  relationshipScore Int?
  // Every relationship update carries its written note (the dialog requires one;
  // the schema agrees).
  notes             String
  source            String?
  sourceUrl         String?

  @@index([partnerId, timestamp])
  // The unscoped reads the composite cannot serve — same shape as the identical index on
  // PhaseState, but only ONE of its two callers: lib/activity's ecosystem feed reads this
  // table too, while lib/summaries' staleness probe never does (its partner branch is
  // scoped). The caller unique to here is app/partners, which loads EVERY relationship
  // state, `orderBy timestamp desc` with no where, and reduces to the latest score plus a
  // 10-point history per partner in JS. Migration 20260729015546 has the account.
  @@index([timestamp])
}


/**
 * An address a human has said is NOT A PERSON — a distribution list, a bot,
 * `noreply@` (#126 decision 2, #127 E15). The "track person" affordance offers to
 * create a Person from an untracked mention; these are the mentions it must stop
 * offering, everywhere and permanently, on one click.
 *
 * A TABLE rather than a column on something, because the thing it records does not
 * belong to any row we have: the whole point is that no Person exists for this
 * address, and inventing one to hold "this is not a person" would be the exact
 * duplicate-human write the affordance is guarded against.
 *
 * `address` is the canonical stored form (`normalizeAddress`), so a mention typed with
 * a capital is the same suppression. Unique because a second row would say nothing the
 * first does not, and `dismissedBy`/`dismissedAt` are here because a permanent
 * app-wide suppression that nobody can attribute is a decision nobody can revisit.
 */
model IgnoredAddress {
  id          Int      @id @default(autoincrement())
  address     String   @unique
  dismissedBy String
  dismissedAt DateTime @default(now())
}
